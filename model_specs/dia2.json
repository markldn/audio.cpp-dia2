{
  "schema_version": 1,
  "family": "dia2",
  "display_name": "Dia2",
  "description": "Native Dia2 dialogue TTS with audio-prefix voice cloning and incremental PCM output.",
  "category": "tts",
  "status": "community",
  "tasks": [
    "tts",
    "clon"
  ],
  "modes": [
    "offline",
    "streaming"
  ],
  "languages": [
    "en"
  ],
  "runtime": {
    "tags": [
      "gguf",
      "stream"
    ]
  },
  "capabilities": {
    "tts": [
      "speaker_reference"
    ],
    "clon": [
      "speaker_reference"
    ]
  },
  "options": {
    "request": [
      {
        "name": "dia2.seed",
        "type": "int",
        "default": 12345,
        "description": "Sampling seed."
      },
      {
        "name": "dia2.temperature",
        "type": "float",
        "default": 0.8,
        "min": 0,
        "description": "Audio sampling temperature."
      },
      {
        "name": "dia2.cfg_scale",
        "type": "float",
        "default": 6.0,
        "description": "Upstream classifier-guidance filter scale."
      },
      {
        "name": "dia2.max_steps",
        "type": "int",
        "default": 1500,
        "min": 20,
        "max": 1500,
        "description": "Maximum audio generation steps."
      },
      {
        "name": "reference_text",
        "type": "string",
        "description": "Transcript of speaker-one reference audio. Approximate timing is used unless reference_words is supplied."
      },
      {
        "name": "dia2.reference_words",
        "type": "string",
        "description": "JSON array of reference words: text, start, end in seconds. Preferred over approximate transcript timing."
      },
      {
        "name": "dia2.prefix_speaker_1",
        "type": "string",
        "description": "Optional speaker-one WAV path; alternatively use voice_ref."
      },
      {
        "name": "dia2.prefix_speaker_2",
        "type": "string",
        "description": "Optional speaker-two WAV path; requires speaker-one reference."
      },
      {
        "name": "dia2.reference_text_2",
        "type": "string",
        "description": "Transcript of speaker-two reference audio."
      },
      {
        "name": "dia2.reference_words_2",
        "type": "string",
        "description": "JSON array of timed speaker-two reference words."
      },
      {
        "name": "dia2.include_prefix",
        "type": "bool",
        "default": false,
        "description": "Keep reference prefix in output instead of cropping it."
      },
      {
        "name": "dia2.chunk_frames",
        "type": "int",
        "default": 4,
        "min": 1,
        "max": 25,
        "description": "Frames per streamed PCM delta; each frame is 80 ms."
      }
    ]
  },
  "packages": [
    {
      "id": "dia2_1b_f16",
      "display_name": "Dia2 1B F16 GGUF",
      "default": true,
      "format": "gguf",
      "precision": "f16",
      "target_directory": "Dia2-1B-GGUF",
      "download": {
        "kind": "huggingface_snapshot",
        "repo": "markldn/Dia2-1B-GGUF",
        "revision": "main",
        "gated": false
      },
      "files": [
        "dia2-f16.gguf",
        "mimi-f16.gguf",
        "config.json",
        "tokenizer.json",
        "tokenizer_config.json",
        "vocab.json",
        "merges.txt",
        "special_tokens_map.json",
        "added_tokens.json"
      ]
    }
  ],
  "ui": {
    "recommended_package": "dia2_1b_f16",
    "tags": [
      "TTS",
      "Dialogue",
      "GGUF"
    ],
    "docs": [
      "docs/dia2.md"
    ]
  },
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
        "config": "model:config.json"
      },
      "tensors": {
        "weights": "weights:"
      }
    }
  ]
}
